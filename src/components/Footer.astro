        <li><FutureLink note="Розділ у розробці">Питання й відповіді</FutureLink></li>
        <li><FutureLink note="Розділ у розробці">Каталог</FutureLink></li>
        <li><FutureLink note="Розділ у розробці">Усі декори</FutureLink></li>
      </ul>
    </div>
    <div>
      <h2 class="ft__h">Контакти</h2>
      <ul>
        <li><a class="ft__tel" href="tel:+380504430419">+38 050 443 04 19</a></li>
        <li><a class="ft__tel" href="tel:+380973069021">+38 097 306 90 21</a></li>
      </ul>
      <p class="ft__legal">Самовивіз: м. Київ, вул. Каховська, 71а<br />Будні 9:00–17:00</p>
    </div>
  </div>
</footer>
<div class="bar" role="region" aria-label="Швидкий зв’язок">
  <span class="bar__price"><b>від 725 грн/м²</b><small>з ПДВ</small></span>
  <a class="btn" href="tel:+380504430419">Подзвонити</a>
</div>
