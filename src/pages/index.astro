---
import "@fontsource-variable/geologica/wght.css";
import "@fontsource-variable/onest/wght.css";
import "../styles/home.css";
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FutureLink from "../components/FutureLink.astro";

const H1 = "Ламінований гіпсокартон zruchno: готова стіна без шпаклювання і фарби";
const img = (c: string) => `/img/decors/${c}.webp`;

const heroLeaves = [
  { c: "936", cat: 1 }, { c: "959", cat: 1 }, { c: "920", cat: 1 }, { c: "975", cat: 1 }, { c: "1-105", cat: 2 },
];
const cats: Record<number, string[]> = {
  1: ["900","907","920","936","944","951","959","967","975","983"],
  2: ["1-105","1-126","1-143","1-150","1-320","1-704","1-709","1-714","1-733","2-2053"],
  3: ["2-101","2-132","2-224","2-272","2-334","2-724","2-739","2-778","3015","3093"],
  4: ["3-201","3-218","3-237","3-262","3-314","3-340","3-745","3-758","3-791","4-3083"],
  5: ["4-303","4-316","4-349","4-419","4-423","4-429","4-541","4-767","5-3025","5011"],
  6: ["5-402","5-414","5-505","5-528","5-533","5-540","5-766","6-518","6-606","6037"],
  7: ["1140","1142","1144","1147","1149","1152","1154","1157","1159","1162"],
};
const formats = [
  { len: 1200, m2: "1,3", price: "1 140–1 610", note: "від 4 шт." },
  { len: 2480, m2: "2,7", price: "1 960–2 840" },
  { len: 2700, m2: "2,9", price: "2 220–3 160" },
  { len: 2970, m2: "3,2", price: "2 340–3 380" },
];
const objects = [
  { f: "hotel1", w: 900, h: 1200, cap: "Готель", sub: "Темний дуб, підсвітка стелі", cls: "o1" },
  { f: "ofice", w: 900, h: 1200, cap: "Офіс", sub: "Бетон світлий, суцільна стіна", cls: "o2" },
  { f: "img-0050", w: 900, h: 914, cap: "Житло", sub: "Акцентна стіна, горіх", cls: "o3" },
  { f: "img-9274", w: 1033, h: 1200, cap: "Магазин", sub: "Бетон світлий", cls: "o4" },
  { f: "1-1-1800", w: 1200, h: 1200, cap: "Офіс", sub: "Приховані двері: бетон і дуб", cls: "o5" },
];
const steps = [
  ["01", "Розрахунок і рахунок", "Менеджер рахує замовлення й виставляє рахунок з ПДВ. Оплата безготівкова."],
  ["02", "Виготовлення", "Усе робимо під замовлення — від 5 робочих днів, залежно від завантаження."],
  ["03", "Доставка або самовивіз", "Перевізником в обласні центри від 20 листів. Самовивіз — Київ, вул. Каховська, 71а."],
  ["04", "Розвантаження", "Для розвантаження потрібні щонайменше 2 людини з боку покупця."],
];
---
<Base lang="uk" title="Ламінований гіпсокартон від виробника — від 725 грн/м² | zruchno" description="Ламінований гіпсокартон zruchno: 350+ декорів ПВХ-плівки, 4 формати листа, основа KNAUF, група Г1. Від 725 грн/м² з ПДВ. Доставка в обласні центри.">
  <Header slot="header" />

  <Section id="hero" class="hero" rec="S-R001,S-R004">
    <div class="hero__wall">
      <div class="hero__sheets">
        {heroLeaves.map((l, i) => (
          <figure class="sheet" style={`--i:${i}`}>
            <img src={img(l.c)} alt={`Декор ${l.c}, категорія ${l.cat}`} width="560" height="874"
              loading="eager" fetchpriority={i === 0 ? "high" : undefined} decoding="async" />
            <figcaption><b>{l.c}</b> кат. {l.cat}</figcaption>
          </figure>
        ))}
      </div>
      <div class="hero__panel">
        <h1>{H1}</h1>
        <p class="hero__lead">Лист 1090 мм у готовому декорі ПВХ-плівки на основі KNAUF. Клей-піна або каркас, а далі стіна готова.</p>
        <dl class="facts">
          <div><dt>декорів</dt><dd>350+</dd></div>
          <div><dt>формати листа</dt><dd>4</dd></div>
          <div><dt>з ПДВ</dt><dd>від 725 грн/м²</dd></div>
        </dl>
        <div class="hero__act">
          <a class="btn" href="#order">Розрахувати замовлення</a>
          <a class="tlink" href="#decors">Підібрати декор</a>
        </div>
      </div>
    </div>
  </Section>

  <Section id="layers" class="layers">
    <div class="wrap layers__grid">
      <div class="layers__text">
        <h2>Що всередині листа</h2>
        <p class="formula"><span>Стіна</span> + <span>клей-піна</span> + <span>ЛГК</span> = готова поверхня</p>
        <p>Лист складається з основи KNAUF H2 товщиною 12,5 мм і декоративної ПВХ-плівки. Шпаклювати й фарбувати його не потрібно.</p>
        <ul class="ways">
          <li><b>На клей-піну.</b> Лист клеїться на підготовлену стіну.</li>
          <li><b>На металевий каркас.</b> Підійде для нерівних стін.</li>
        </ul>
        <p><FutureLink note="Розділ у розробці" class="tlink">Інструкція з монтажу</FutureLink></p>
      </div>
      <div class="stack" data-reveal role="img" aria-label="Розріз: стіна, клей-піна, плита KNAUF H2 12,5 мм, ПВХ-плівка">
        <div class="layer layer--wall"><i>Стіна</i></div>
        <div class="layer layer--foam"><i>Клей-піна</i></div>
        <div class="layer layer--board"><i>Плита KNAUF H2</i><em>12,5 мм</em></div>
        <div class="layer layer--film" style={`--img:url(${img("959")})`}><i>ПВХ-плівка</i></div>
      </div>
    </div>
  </Section>

  <Section id="decors" class="decors" rec="S-R006">
    <div class="wrap">
      <h2>350+ декорів у 7 цінових категоріях</h2>
      <p class="warn">Колір і фактура плівки в реальності та на екрані не збігаються. Зразки надсилаємо Новою Поштою — до 2 листів.</p>
      <div class="decors__grid">
        <div class="wallview">
          <div class="wallview__wall" id="wall" style={`--a:url(${img("936")})`}>
            <div class="wallview__layer is-on"><i></i><i></i><i></i></div>
            <div class="wallview__layer"><i></i><i></i><i></i></div>
          </div>
          <p class="wallview__cap" id="wall-cap" aria-live="polite">Декор <b>936</b> · категорія 1</p>
        </div>
        <div class="decors__pick">
          <div class="tabs" role="tablist" aria-label="Цінові категорії декорів">
            {Object.keys(cats).map((k) => (
              <button type="button" class="tab" role="tab" id={`tab-${k}`} aria-controls={`panel-${k}`} aria-selected={k === "1" ? "true" : "false"} data-cat={k}>
                Кат. {k}
              </button>
            ))}
          </div>
          {Object.entries(cats).map(([k, list]) => (
            <div class="panel" role="tabpanel" id={`panel-${k}`} aria-labelledby={`tab-${k}`} data-cat={k}>
              <p class="panel__h">Категорія {k}{k === "7" ? " · UV-стійка серія Winshield" : ""}</p>
              <ul class="swatches">
                {list.map((c) => (
                  <li>
                    <button type="button" class="sw" data-code={c} data-cat={k} data-src={img(c)} aria-pressed={c === "936" ? "true" : "false"} aria-label={`Декор ${c}, категорія ${k}`}>
                      <img src={img(c)} alt="" width="560" height="874" loading="lazy" decoding="async" />
                      <span>{c}</span>
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          ))}
          <p class="decors__more"><FutureLink note="Розділ у розробці" class="tlink">Усі декори</FutureLink></p>
        </div>
      </div>
    </div>
  </Section>

  <Section id="formats" class="formats" rec="S-R010">
    <div class="wrap">
      <h2>Чотири формати листа</h2>
      <p class="formats__lead">Ширина всіх листів — 1090 мм, товщина — 12,5 мм. Ціна за лист залежить від категорії декору.</p>
      <div class="draw" data-reveal>
        {formats.map((f, i) => (
          <div class="fmt" style={`--i:${i};--h:${f.len}`}>
            <div class="fmt__sheet" style={`--img:url(${img(["936", "959", "920", "975"][i])})`}><span class="fmt__len">{f.len} мм</span></div>
            <div class="fmt__w"><span>1090 мм</span></div>
            <p class="fmt__name">{f.len}×1090 мм</p>
            <p class="fmt__m2">{f.m2} м²</p>
            <p class="fmt__price"><b>{f.price} грн</b> <small>за лист з ПДВ{f.note ? `, ${f.note}` : ""}</small></p>
          </div>
        ))}
      </div>
      <p class="formats__acc"><b>Комплектуючі в декорі листа.</b> Ламіновані куточки 20×20 і 20×10 мм, П-профіль — 305–520 грн.</p>
      <p class="note">Ціни орієнтовні. Остаточну суму рахує менеджер.</p>
    </div>
  </Section>

  <Section id="objects" rec="S-R011" class="objects">
    <div class="wrap">
      <h2>Матеріал у роботі</h2>
      <div class="ogrid">
        {objects.map((o) => (
          <figure class={`obj ${o.cls}`}>
            <img src={`/img/objects/${o.f}.webp`} alt={`${o.cap}: ${o.sub}`} width={o.w} height={o.h} loading="lazy" decoding="async" />
            <figcaption><b>{o.cap}</b> {o.sub}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </Section>

  <Section id="proof" class="proof" rec="S-R009">
    <div class="wrap proof__grid">
      <h2>Чим підтверджено</h2>
      <ul class="docs">
        <li><h3>Основа — плита KNAUF H2</h3><p>Екосертифікат «Жива планета», ТОВ «Кнауф Гіпс Київ». Чинний до 05.03.2029.</p></li>
        <li><h3>Пожежна група Г1</h3><p>Протокол випробувань готового листа, ДСНС. Видано 08.07.2026, чинний до 07.07.2030.</p></li>
        <li><h3>Санітарні висновки</h3><p>На ПВХ-плівки JCT (Корея) і TIANAN (Китай) та на клей MITOL.</p></li>
      </ul>
      <p class="proof__more"><FutureLink note="Розділ у розробці" class="tlink">Сертифікати</FutureLink></p>
    </div>
  </Section>

  <Section id="order" class="order">
    <div class="wrap">
      <h2>Як замовити</h2>
      <ol class="steps">
        {steps.map(([n, t, d]) => (
          <li><span class="steps__n">{n}</span><h3>{t}</h3><p>{d}</p></li>
        ))}
      </ol>
      <div class="call">
        <div class="call__tel">
          <a href="tel:+380504430419">+38 050 443 04 19</a>
          <a href="tel:+380973069021">+38 097 306 90 21</a>
          <p>Будні 9:00–17:00 · Київ, вул. Каховська, 71а</p>
        </div>
        <div class="call__form" aria-label="Форма зворотного дзвінка (з’явиться пізніше)">
          <label>Ім’я<input type="text" disabled autocomplete="off" /></label>
          <label>Телефон<input type="tel" disabled autocomplete="off" /></label>
          <button type="button" class="btn" disabled>Передзвонити вам</button>
          <p class="note">Онлайн-заявка з’явиться в повній версії сайту. Зараз — дзвінок за номерами.</p>
        </div>
      </div>
    </div>
  </Section>

  <Footer slot="footer" />
  <script src="../scripts/decors.ts"></script>
</Base>
